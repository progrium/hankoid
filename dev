#!/usr/bin/env bash
# Local dev loop: starts Postgres and Mailpit from compose.yaml, then runs a `-tags dev` build of
# `hankoid serve all` on the host (public :8000, admin :8001, frontend :8080 with live reload).
#
# State lives in .local/ (gitignored) and is created on first run:
#   .local/hanko.yaml        config; edit freely, it's never overwritten
#   .local/oidc-signing.pem  OIDC signing key
#   .local/cache/            build output
#
# ADMINS (comma-separated) seeds the admin allowlist in a new config; it defaults to your git email.
# Extra arguments are passed to `serve all`. Ctrl+C stops hankoid; the containers keep running
# (stop them with: docker compose stop).
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LOCAL="$ROOT/.local"
CONFIG="$LOCAL/hanko.yaml"
HANKOID="$LOCAL/cache/hankoid-dev"

log() { echo "dev: $*"; }
die() {
	echo "dev: $*" >&2
	exit 1
}

for cmd in go docker; do
	command -v "$cmd" >/dev/null || die "$cmd not found in PATH"
done

for port in 8000 8001 8080; do
	if lsof -nP -iTCP:"$port" -sTCP:LISTEN >/dev/null 2>&1; then
		die "port $port already in use"
	fi
done

cd "$ROOT"
mkdir -p "$LOCAL/cache"

if [[ ! -f "$CONFIG" ]]; then
	admins="${ADMINS:-$(git config user.email 2>/dev/null || true)}"
	admins="${admins:-admin@example.com}"
	secret="$(openssl rand -hex 32 2>/dev/null || LC_ALL=C tr -dc 'a-f0-9' </dev/urandom | head -c 64)"
	log "creating .local/hanko.yaml (admins: $admins)"
	{
		cat <<EOF
# Local dev config, generated by ./dev. Postgres and Mailpit come from compose.yaml.
database:
  user: hanko
  password: hanko
  host: localhost
  port: 5432
  dialect: postgres
  database: hanko
secrets:
  keys:
    - $secret
service:
  name: Hanko Local
# Passcode emails land in Mailpit: http://localhost:8025
email_delivery:
  smtp:
    host: localhost
    port: "1025"
webauthn:
  relying_party:
    id: localhost
    origins:
      - http://localhost:8080
# Plain http, so no Secure cookies. lax so the session cookie reaches /oidc/authorize on redirects.
session:
  cookie:
    secure: false
    same_site: lax
cors:
  allow_origins:
    - http://localhost:8080
server:
  admin:
    address: 127.0.0.1:8001  # Hanko's admin API is unauthenticated; loopback only
  frontend:
    address: 127.0.0.1:8080
    public_url: http://localhost:8080
    # Who may use /admin: users (IDs, usernames, verified emails) and/or an organization + roles.
    admin_access:
      users:
EOF
		IFS=',' read -ra list <<<"$admins"
		for a in "${list[@]}"; do
			a="$(echo "$a" | xargs)"
			[[ -n "$a" ]] && echo "        - $a"
		done
		cat <<EOF
# OIDC provider (issuer http://localhost:8080/oidc). Add clients to enable it.
oidc:
  signing_key_file: oidc-signing.pem
  store: postgres
  clients: []
EOF
	} >"$CONFIG"
fi

case "$(uname -m)" in
arm64 | aarch64) export PLATFORM=linux/arm64 ;;
x86_64 | amd64) export PLATFORM=linux/amd64 ;;
esac

log "starting postgres and mailpit (docker compose, ${PLATFORM:-default platform})"
if ! docker compose up -d --wait postgres mailpit; then
	echo "dev: postgres failed to start; recent log:" >&2
	docker compose logs --no-log-prefix --tail 25 postgres >&2 || true
	die "if the data volume was created by an incompatible image, reset it with: docker compose down -v"
fi

log "building hankoid (-tags dev)"
go build -tags dev -o "$HANKOID" ./cmd/hankoid

if [[ ! -f "$LOCAL/oidc-signing.pem" ]]; then
	log "generating OIDC signing key (.local/oidc-signing.pem)"
	"$HANKOID" oidc genkey -o "$LOCAL/oidc-signing.pem"
fi

log "running migrations"
"$HANKOID" migrate up --config "$CONFIG"

log "admin at http://localhost:8080/admin/ (sign in at /signin, emails at http://localhost:8025)"
exec "$HANKOID" serve all --config "$CONFIG" "$@"
